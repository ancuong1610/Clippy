# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Titles, hooks, caption fixes, chat picks — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id (default: openrouter/auto)
OPENROUTER_MODEL=

# Posting (YouTube, Instagram, TikTok) + analytics — https://composio.dev (project key, starts with ak_)
COMPOSIO_API_KEY=

# Optional: phone push with each TikTok draft's caption — pick a hard-to-guess topic and subscribe in the ntfy app
NTFY_TOPIC=
