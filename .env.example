# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Titles, hooks, caption fixes, chat picks — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id (default: openrouter/auto)
OPENROUTER_MODEL=

# YouTube auto-upload — https://composio.dev (project key, starts with ak_)
COMPOSIO_API_KEY=
